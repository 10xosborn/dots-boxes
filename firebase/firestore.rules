rules_version = '2';
// Firestore rules for Dots & Boxes. Publish in: Firebase console → Firestore Database → Rules.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function validName(n) { return n is string && n.size() > 0 && n.size() <= 16; }
    function validScore(s) {
      return s.n in [3, 4, 5, 6]
        && s.diff in ['easy', 'medium', 'hard']
        && s.result in ['win', 'loss', 'draw']
        && s.ms is int && s.ms >= 2000 && s.ms < 86400000
        && s.mine is int && s.theirs is int && s.mine + s.theirs == s.n * s.n
        && ((s.result == 'win' && s.mine > s.theirs) || (s.result == 'loss' && s.mine < s.theirs) || (s.result == 'draw' && s.mine == s.theirs))
        && s.moves is list && s.moves.size() == 2 * s.n * (s.n + 1);
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow write: if isOwner(uid) && validName(request.resource.data.name);
      match /scores/{id} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid) && request.resource.data.uid == uid && validScore(request.resource.data);
      }
    }

    // Leaderboard summaries: anyone can read; players can only add one game at a time to their own row.
    match /leaderboards/{board}/players/{uid} {
      allow read: if true;
      allow delete: if isOwner(uid);
      allow create: if isOwner(uid) && validName(request.resource.data.name)
        && request.resource.data.uid == uid
        && request.resource.data.games == 1 && request.resource.data.wins in [0, 1];
      allow update: if isOwner(uid) && validName(request.resource.data.name)
        && request.resource.data.uid == uid
        && (
          // one more game recorded
          (request.resource.data.games == resource.data.games + 1
            && request.resource.data.wins >= resource.data.wins
            && request.resource.data.wins <= resource.data.wins + 1)
          // or a name change only
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
        );
    }
  }
}
